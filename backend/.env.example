# Copiar a .env y completar los valores reales (el .env real NO se commitea).
# Groq (IA en la nube: comandos, voz, imagen)
GROQ_API_KEY=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
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Google Gemini (fallback de nube)
# Obtener en https://aistudio.google.com/app/apikey
# También se acepta GOOGLE_API_KEY o GOOGLE_GENERATIVE_AI_API_KEY.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Modelos alternativos si el principal devuelve 404 (separados por coma).
GEMINI_FALLBACK_MODELS=gemini-2.0-flash,gemini-1.5-flash-latest

# Proveedor de IA: 'groq' (nube), 'gemini' (nube) u 'ollama' (local)
AI_PROVIDER=groq

# Ollama (si AI_PROVIDER=ollama). Expone una API compatible con OpenAI.
OLLAMA_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3
# Opcional: modelo multimodal para /api/ai/from-image.
# OLLAMA_VISION_MODEL=llava

# Autenticación (Fase 1: JWT)
# false = todo abierto como antes; true = exige login en REST (+token en WS)
AUTH_ENABLED=true
# Secreto de al menos 32 caracteres. Generar con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambiar-por-un-secreto-largo-de-al-menos-64-caracteres
JWT_EXPIRATION=7d

PORT=1234

# PostgreSQL / Neon
DATABASE_URL=postgresql://usuario:password@host/db?sslmode=require
